    "sources": [
      {
        "id": "metaview.conversations",
        "kind": "events",
        "reads": "meeting",
        "method": "events_list",
        "input": {
          "source": "conversations"
        },
        "service": {
          "id": "metaview.conversations",
          "label": "Conversations"
        },
        "operations": [
          "get_user_context",
          "search_conversations"
        ],
        "scope": {
          "keys": [
            "reports"
          ],
          "describe": "The saved reports whose conversations to read; omit it to read every conversation the account can see."
        },
        "cadence": {
          "suggestMinutes": 15
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 262144,
        "urlHosts": [
          "app.metaview.ai"
        ]
      }
    ],
    "actions": [],
    "events": {}
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "fixtures": "node scripts/record-fixture.mjs",
    "docs": "plugin-kit docs",
    "docs:check": "plugin-kit docs --check",
    "check": "npm run typecheck && npm run bundle && npm run test && plugin-kit check && plugin-kit docs --check"
  },
  "devDependencies": {
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/plugin-contract": "github:we-the-rebel-alliance/plugin-contract#v0.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
